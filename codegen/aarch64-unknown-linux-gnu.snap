# Hot paths on aarch64-unknown-linux-gnu, checked by `cargo xtask codegen check`.
# One function per line: its Rust path, then what the pinned toolchain's
# release build made of it. `asm` is a hash of the inline assembly's mnemonics
# and their count, `glue` the instructions the compiler generated around it,
# `calls` how many of those are calls. Rewrite the numbers with
# `cargo xtask codegen bless --target aarch64-unknown-linux-gnu`.
crc_turbo::crc32::fusion::aarch64::asm::crc32c_short asm=b5b51044d33512fa/27 glue=1 calls=0
crc_turbo::crc32::fusion::aarch64::asm::crc32_short asm=3a83acc5e640f95a/27 glue=1 calls=0
crc_turbo::crc32::fusion::aarch64::asm::crc32c_blocks asm=a1f2e622d8360fb3/45 glue=1 calls=0
crc_turbo::crc32::fusion::aarch64::asm::crc32_blocks asm=306f1fc990771c8b/45 glue=1 calls=0
crc_turbo::crc32::fusion::aarch64::asm::crc32c_eor3_v4 asm=6d7dd7068b55a398/62 glue=1 calls=0
